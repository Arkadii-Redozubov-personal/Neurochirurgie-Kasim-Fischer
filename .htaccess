# ----------------------------------------------------------------------
# Neurochirurgie Dr. med. Kasim Fischer-Rahimov & Kollegen
# Apache Configuration & Routing (.htaccess)
# ----------------------------------------------------------------------

# Prevent directory listings
Options -Indexes

# Custom 404 Error Document
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Browser Caching & Expirations (Images, Fonts, CSS, JS)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML - dynamic, do not cache so CMS updates appear immediately
    ExpiresByType text/html "access plus 0 seconds"

    # Images & Icons - cache for 1 year
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Web Fonts - cache for 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"

    # CSS & JavaScript - cache for 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Static Assets: 1 year cache
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CSS & JS: 1 month cache
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # HTML files: Never cache HTML so CMS edits and design updates apply immediately
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Security: Protect hidden files and sensitive project files
    RewriteRule ^(\.git|\.env|publish-config\.php|cms_data\.json|clean_seed\.json) - [F,L]

    # Clean 301 Redirects for Old WordPress URLs
    RewriteRule ^ueber-uns/?$ /unser-team.html [R=301,L]
    RewriteRule ^team/?$ /unser-team.html [R=301,L]
    RewriteRule ^kontakt/?$ /sprechzeiten.html [R=301,L]
    RewriteRule ^leistungen/?$ /behandlungen.html [R=301,L]
    RewriteRule ^schwerpunkte/?$ /praxis-schwerpunkte.html [R=301,L]
    RewriteRule ^behandlungen/?$ /behandlungen.html [R=301,L]
    RewriteRule ^faq/?$ /patienten.html [R=301,L]
    RewriteRule ^standorte/?$ /sprechzeiten.html [R=301,L]
    RewriteRule ^termin/?$ /sprechzeiten.html [R=301,L]
    RewriteRule ^datenschutz/?$ /datenschutz.html [R=301,L]
    RewriteRule ^impressum/?$ /impressum.html [R=301,L]

    # If the requested file or directory exists on disk, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # For any non-existent resource, serve /404.html
    RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
